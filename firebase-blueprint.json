{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and store authorization role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "role": { "type": "string", "enum": ["seller", "admin", "staff"] }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Store owner profile for authenticated sellers"
    }
  }
}
